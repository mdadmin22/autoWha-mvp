# Conexión a base de datos
# Para desarrollo local usar SQLite (no requiere instalar nada)
DATABASE_URL=sqlite:///./autoWha.db

# Orígenes permitidos para CORS (separar con coma si hay varios)
CORS_ORIGINS=http://localhost:3000

# Contraseña del panel de administración (/admin)
# Cambiar por una contraseña segura antes de cualquier deploy
ADMIN_PASSWORD=cambiar_esto

# URL pública del frontend (usada para construir links de gestión en notificaciones)
FRONTEND_URL=http://localhost:3000
